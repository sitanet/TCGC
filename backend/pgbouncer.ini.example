; ============================================================================
; PgBouncer Configuration for Ask Wing AI
; ============================================================================
; Copy this to pgbouncer.ini and adjust values for your environment
; ============================================================================

; ============================================================================
; [databases] - Database Connection Settings
; ============================================================================
[databases]

; Main Ask Wing AI database
ask_wing_ai = host=localhost port=5432 dbname=ask_wing_ai

; Development database (optional)
ask_wing_ai_dev = host=localhost port=5432 dbname=ask_wing_ai_dev

; Test database (optional)
ask_wing_ai_test = host=localhost port=5432 dbname=ask_wing_ai_test

; ============================================================================
; [pgbouncer] - PgBouncer Settings
; ============================================================================
[pgbouncer]

; IP address and TCP port the PgBouncer server binds to.
; Leaving them empty means all addresses in all interfaces.
listen_addr = localhost
listen_port = 6432

; Databases to manage
admin_users = postgres

; ============================================================================
; Connection Pooling Configuration
; ============================================================================

; Default connection pooling mode
; session - one connection per client
; transaction - one connection per transaction  (RECOMMENDED for web apps)
; statement - one connection per statement (for autocommit-only clients)
pool_mode = transaction

; Maximum number of client connections allowed
; Default: 100
max_client_conn = 1000

; Default pool size - connections to maintain per database/user
; Default: 25
default_pool_size = 25

; Minimum number of connections to keep available
; Default: 10
min_pool_size = 10

; Reserve pool size - extra connections for spikes
; Default: 5
reserve_pool_size = 5

; Timeout to grab a connection from reserve pool (seconds)
; Default: 3
reserve_pool_timeout = 3

; Maximum number of connections per single database (regardless of users)
; Superuser connections are not limited by this.
; Default: unlimited
max_db_connections = 100

; Maximum number of connections per user + database combination
; Default: unlimited
max_user_connections = 50

; ============================================================================
; Connection Timeout Settings
; ============================================================================

; Query timeout (seconds)
; Idle queries in transaction get closed.
; Default: 0 (disabled)
query_wait_timeout = 120

; Timeout for idle connections (seconds)
; Connection is closed if no query is received in this time
; Default: 600
client_idle_timeout = 600

; Timeout for idle connections that are in a transaction (seconds)
; Default: idle_in_transaction_session_timeout (PostgreSQL setting)
idle_in_transaction_session_timeout = 600

; TCP connection timeout (seconds)
; Default: 15
connect_timeout = 15

; ============================================================================
; Authentication
; ============================================================================

; Authentication type
; md5 - use MD5 hash
; plain - plain text password
; cert - SSL certificate (requires ssl_certfile and ssl_keyfile)
; scram-sha-256 - SCRAM-SHA-256 authentication
auth_type = md5

; Authentication file location
; Format: "user" "password"
auth_file = /etc/pgbouncer/userlist.txt

; Query to get user credentials (optional, for dynamic auth)
; auth_query = SELECT usename, passwd FROM pg_user WHERE usename=$1

; ============================================================================
; Logging
; ============================================================================

; Syslog settings
; Logging will be to syslog by default
; syslog_facility = LOCAL0
; syslog_ident = pgbouncer

; Log file location (if not using syslog)
; Make sure this directory exists and is writable by pgbouncer
logfile = /var/log/pgbouncer/pgbouncer.log

; PID file location
pidfile = /var/run/pgbouncer/pgbouncer.pid

; Verbosity - controls how verbose the logging is
; 0 - errors only
; 1 - errors + warnings
; 2 - errors + warnings + info (RECOMMENDED)
; 3 - errors + warnings + info + debug
; Default: 0
verbose = 2

; Log connections and disconnections
; Default: 1
log_connections = 1

; Log disconnections
; Default: 1
log_disconnections = 1

; Log detailed statistics to log file or syslog
; Default: 0
log_pooler_stats = 1

; Log client commands to syslog
; Default: 0
log_client_queries = 0

; ============================================================================
; Statistics and Monitoring
; ============================================================================

; Period to collect statistics (seconds)
; Statistics are written to the log file
; Default: 15
stats_period = 60

; Connection request timeout (seconds)
; The time a client can wait for a slot in the pool
; Default: 0 (no timeout)
request_timeout = 0

; ============================================================================
; Performance Tuning
; ============================================================================

; TCP keep-alive settings
; Default: 1 (enabled)
tcp_keepalives = 1

; TCP keepalive idle time (seconds)
; Default: 30
tcp_keepidle = 30

; TCP keepalive interval (seconds)
; Default: 10
tcp_keepintvl = 10

; TCP keepalive probe count
; Default: 5
tcp_keepcnt = 5

; Socket receive/send buffer sizes
; setsockopt SO_RCVBUF / SO_SNDBUF
; Default: OS default
; tcp_socket_buffer_size = 8192

; Nodelay setting for TCP_NODELAY socket option
; Default: 1
tcp_user_timeout = 0

; ============================================================================
; SSL/TLS Configuration
; ============================================================================

; SSL mode
; disable - SSL connections are not allowed
; allow - SSL connections are allowed but not required
; prefer - SSL connections are preferred (default)
; require - SSL connections are required
; Default: allow
ssl_mode = disable

; Path to SSL certificate
; ssl_certfile = /path/to/pgbouncer.crt

; Path to SSL key
; ssl_keyfile = /path/to/pgbouncer.key

; Path to CA certificate for client verification
; ssl_ca_file = /path/to/ca.crt

; ============================================================================
; Server Connection Settings
; ============================================================================

; Server connection idle timeout (seconds)
; Server connections are closed if idle for this long
; Default: 600
server_idle_timeout = 600

; Server connection lifetime (seconds)
; Connections are closed and reconnected after this time
; Default: 3600
server_lifetime = 3600

; Server connection reuse (seconds)
; Interval between server reconnects
; Default: 0 (immediate)
server_connect_timeout = 15

; ============================================================================
; Advanced Settings
; ============================================================================

; Should server-provided NOTICE and INFO log be forwarded to clients?
; Default: 1
server_lifetime = 3600

; Client side character set encoding
; Default: auto
client_encoding = auto

; Pause all operations while in maintenance
; Default: 0 (disabled)
; online_mode = 1

; Compatibility mode for older PostgreSQL clients
; Default: 1
pkt_buf = 4096

; ============================================================================
; Performance Notes
; ============================================================================

; For Ask Wing AI with typical load:
; - Use pool_mode = transaction (default above)
; - default_pool_size = 25 (adjust based on load)
; - reserve_pool_size = 5 (for handling spikes)
; - query_wait_timeout = 120 (allow up to 2 minutes for queries)
; 
; For read-heavy workloads:
; - Consider pool_mode = session
; - Increase default_pool_size to 50
; - Increase reserve_pool_size to 10
;
; For embedded/light workloads:
; - Decrease pool sizes accordingly
; - Consider disabling connection pooling entirely

; ============================================================================
; Monitoring and Statistics
; ============================================================================

; To get current pool statistics, connect to pgbouncer as admin:
; psql -U postgres -h localhost -p 6432 -d pgbouncer
;
; Useful commands:
; SHOW POOLS;           - Show all pools and their state
; SHOW CLIENTS;         - Show all client connections
; SHOW SERVERS;         - Show all server connections
; SHOW STATS;           - Show statistics
; SHOW CONFIG;          - Show current configuration
; RELOAD;               - Reload configuration
; PAUSE;                - Pause pool operations
; RESUME;               - Resume pool operations
; SHUTDOWN;             - Shutdown pgbouncer

; ============================================================================
; End of PgBouncer Configuration
; ============================================================================
