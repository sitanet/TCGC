# ============================================================================
# Ask Wing AI - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database backend
DB_ENGINE=django.db.backends.postgresql

# Database credentials
DB_NAME=ask_wing_ai
DB_USER=ask_wing_user
DB_PASSWORD=your_secure_password_here_min_32_chars

# Database host and port
DB_HOST=localhost
DB_PORT=5432

# Use PgBouncer for connection pooling (set to True in production)
USE_PGBOUNCER=False

# pgvector configuration
PGVECTOR_DIMENSIONS=1536
PGVECTOR_INDEX_TYPE=ivfflat

# Connection pool settings
CONN_MAX_AGE=600
DB_CONN_TIMEOUT=10

# ============================================================================
# DJANGO SETTINGS
# ============================================================================

# Django environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-django-secret-key-generate-with-secrets.token_urlsafe(50)

# Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,*.localhost

# ============================================================================
# OPENAI API CONFIGURATION
# ============================================================================

# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx

# Models
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GPT_MODEL=gpt-4
OPENAI_WHISPER_MODEL=whisper-1

# API settings
OPENAI_API_TIMEOUT=30
OPENAI_MAX_RETRIES=3
OPENAI_ORGANIZATION=your_org_id_if_applicable

# ============================================================================
# VECTOR SEARCH CONFIGURATION
# ============================================================================

# Vector search parameters
VECTOR_SEARCH_TOP_K=5
VECTOR_SEARCH_MIN_SIMILARITY=0.7
VECTOR_SEARCH_CHUNK_SIZE=1000
VECTOR_SEARCH_CHUNK_OVERLAP=200

# ============================================================================
# REDIS CONFIGURATION (for caching and Celery)
# ============================================================================

# Redis URL
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache settings
CACHE_BACKEND=redis

# ============================================================================
# CELERY CONFIGURATION
# ============================================================================

# Celery broker (typically Redis)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery settings
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# Task settings
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=280
CELERY_TASK_MAX_RETRIES=3

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Daily question limit per user
RATE_LIMIT_DAILY_QUESTIONS=50

# Rate limit cache timeout (seconds)
RATE_LIMIT_CACHE_TIMEOUT=86400  # 24 hours

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://example.com

# CSRF settings
CSRF_TRUSTED_ORIGINS=localhost,127.0.0.1,example.com

# HTTPS/TLS
SECURE_SSL_REDIRECT=False  # Set to True in production
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SESSION_COOKIE_SECURE=False  # Set to True in production
CSRF_COOKIE_SECURE=False  # Set to True in production

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level
LOG_LEVEL=DEBUG

# Log files location
LOGS_DIR=./logs

# Database query logging
LOG_DATABASE_QUERIES=True
LOG_SLOW_QUERIES_MS=1000

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# File storage backend
STORAGE_BACKEND=local  # or 's3' for AWS S3

# S3 Configuration (if using S3)
AWS_S3_REGION_NAME=us-east-1
AWS_S3_BUCKET_NAME=tcgc-ask-wing-ai
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Local storage directory
LOCAL_STORAGE_PATH=./storage

# ============================================================================
# EMAIL CONFIGURATION (for notifications and alerts)
# ============================================================================

# Email backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_password

# From address
DEFAULT_FROM_EMAIL=noreply@thecitygatechurch.org

# ============================================================================
# MONITORING AND ANALYTICS
# ============================================================================

# Sentry error tracking (optional)
SENTRY_DSN=

# Data Dog or similar monitoring
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ============================================================================
# TRANSCRIPTION CONFIGURATION
# ============================================================================

# Audio transcription settings
TRANSCRIPTION_CHUNK_SIZE_MB=25
TRANSCRIPTION_RETRY_ATTEMPTS=3
TRANSCRIPTION_TIMEOUT_SECONDS=600

# FFmpeg settings (for audio processing)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================

# Session timeout (seconds)
SESSION_TIMEOUT=1800  # 30 minutes

# Session cookie age (seconds)
SESSION_COOKIE_AGE=1209600  # 2 weeks

# ============================================================================
# MODERATION CONFIGURATION
# ============================================================================

# Enable question moderation
MODERATION_ENABLED=True

# Moderation alert email
MODERATION_ALERT_EMAIL=admin@example.com

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Development server
DEV_SERVER_HOST=127.0.0.1
DEV_SERVER_PORT=8000

# Test database (for running tests)
TEST_DATABASE_NAME=test_ask_wing_ai

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# Production API URL
PRODUCTION_API_URL=https://api.thecitygatechurch.org

# Backup settings
BACKUP_ENABLED=True
BACKUP_FREQUENCY=daily  # hourly, daily, weekly
BACKUP_RETENTION_DAYS=30

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable features
FEATURE_AUDIO_TRANSCRIPTION=True
FEATURE_VECTOR_SEARCH=True
FEATURE_GPT4_RESPONSES=True
FEATURE_RATE_LIMITING=True
FEATURE_MODERATION=True

# ============================================================================
# End of Environment Variables
# ============================================================================
